rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email in ['jasmeenwilliams@southernwellofsouthms.com', 'jwi4819@wgu.edu'];
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.role is string && data.role in ['client', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCareDossier(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'fields', 'tables', 'completionPercent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'fields', 'tables', 'completionPercent', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.fields is map && data.fields.size() <= 45
        && data.tables is map && data.tables.size() <= 10
        && data.completionPercent is number && data.completionPercent >= 0 && data.completionPercent <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLaunchKit(data, userId) {
      return data.keys().hasAll(['ownerId', 'checkedIds', 'questions', 'dossierCard', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'checkedIds', 'questions', 'dossierCard', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.checkedIds is list && data.checkedIds.size() <= 20
        && (data.checkedIds.size() == 0 || (data.checkedIds[0] is string && data.checkedIds[0].size() <= 64))
        && data.questions is list && data.questions.size() <= 50
        && (data.questions.size() == 0 || data.questions[0] is map)
        && data.dossierCard is map && data.dossierCard.size() <= 12
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConsultation(data) {
      return data.keys().hasAll([
          'ownerId', 'referenceCode', 'contactName', 'contactEmailOrPhone',
          'lovedOneCity', 'serviceInterest', 'preferredFormat', 'notes',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'referenceCode', 'contactName', 'contactEmailOrPhone',
          'lovedOneCity', 'serviceInterest', 'preferredFormat', 'notes',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 24
        && data.referenceCode.matches('^SW-[0-9]{4,8}$')
        && data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 120
        && data.contactEmailOrPhone is string && data.contactEmailOrPhone.size() >= 3 && data.contactEmailOrPhone.size() <= 160
        && data.lovedOneCity is string && data.lovedOneCity.size() >= 2 && data.lovedOneCity.size() <= 80
        && data.serviceInterest is string && data.serviceInterest in [
          'foundation-assessment',
          'medication-concierge',
          'clinic-accompaniment',
          'advance-care-planning',
          'general-consultation'
        ]
        && data.preferredFormat is string && data.preferredFormat in [
          'Phone Call',
          'Video Family Meeting',
          'In-Home Visit'
        ]
        && data.notes is string && data.notes.size() <= 2000
        && data.status is string && data.status in ['pending', 'scheduled', 'completed', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPracticeOps(data) {
      return data.keys().hasAll([
          'ownerId', 'preset', 'clients', 'checkins', 'actions',
          'referrals', 'payments', 'meds', 'mmasResponses',
          'bhlsResponses', 'launchDone', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'preset', 'clients', 'checkins', 'actions',
          'referrals', 'payments', 'meds', 'mmasResponses',
          'bhlsResponses', 'launchDone', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.preset is string && data.preset in ['strict', 'standard', 'high']
        && data.clients is list && data.clients.size() <= 150
        && (data.clients.size() == 0 || data.clients[0] is map)
        && data.checkins is list && data.checkins.size() <= 300
        && (data.checkins.size() == 0 || data.checkins[0] is map)
        && data.actions is list && data.actions.size() <= 300
        && (data.actions.size() == 0 || data.actions[0] is map)
        && data.referrals is list && data.referrals.size() <= 200
        && (data.referrals.size() == 0 || data.referrals[0] is map)
        && data.payments is list && data.payments.size() <= 300
        && (data.payments.size() == 0 || data.payments[0] is map)
        && data.meds is list && data.meds.size() <= 300
        && (data.meds.size() == 0 || data.meds[0] is map)
        && data.mmasResponses is map && data.mmasResponses.size() == 8
        && data.bhlsResponses is map && data.bhlsResponses.size() == 3
        && data.launchDone is map && data.launchDone.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClientCheckIn(data) {
      return data.keys().hasAll([
          'ownerId', 'clientId', 'date', 'type', 'note', 'done', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'clientId', 'date', 'type', 'note', 'done', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 64
        && data.clientId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && data.type is string && data.type in [
          'Phone',
          'Home visit',
          'Pill tray review',
          'Self-advocacy check-in',
          'Appointment Accompaniment'
        ]
        && data.note is string && data.note.size() >= 1 && data.note.size() <= 1000
        && data.done is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPassHash(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function isValidAccessPass(data, passHash) {
      return data.keys().hasAll([
          'passHash', 'area', 'label', 'agreementSigned', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'passHash', 'area', 'label', 'agreementSigned', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.passHash is string && data.passHash == passHash && isValidPassHash(data.passHash)
        && data.area is string && data.area in ['family_suite', 'operations']
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
        && data.agreementSigned is bool
        && data.active is bool
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Admins Collection
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isOwner(adminUid);
      allow list, create, update, delete: if false;
    }

    // 5. Users & Nested Private Client Workspaces
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role == 'client' || isBootstrappedAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt'])) ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );

      allow delete: if false;

      // Digital Care Dossier Subcollection
      match /dossiers/{dossierId} {
        allow get: if isValidId(userId) && isValidId(dossierId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isVerifiedUser()
          && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isValidId(userId) && isValidId(dossierId)
          && (isOwner(userId) || isAdmin())
          && isValidCareDossier(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId) && isValidId(dossierId)
          && isValidCareDossier(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'fields', 'tables', 'completionPercent', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(dossierId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // Family Launch Kit Subcollection
      match /launchKits/{kitId} {
        allow get: if isValidId(userId) && isValidId(kitId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isVerifiedUser()
          && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isValidId(userId) && isValidId(kitId)
          && (isOwner(userId) || isAdmin())
          && isValidLaunchKit(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId) && isValidId(kitId)
          && isValidLaunchKit(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly(['checkedIds', 'questions', 'dossierCard', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(kitId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // 6. Confidential Consultation Requests
    match /consultations/{consultationId} {
      allow get: if isValidId(consultationId)
        && isVerifiedUser()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isVerifiedUser()
        && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isValidId(consultationId)
        && isVerifiedUser()
        && isValidConsultation(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(consultationId)
        && isValidConsultation(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().referenceCode == existing().referenceCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
          || (
            isOwner(existing().ownerId)
            && existing().status in ['pending', 'scheduled']
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['preferredFormat', 'notes', 'lovedOneCity', 'serviceInterest', 'contactEmailOrPhone', 'updatedAt'])
          )
        );

      allow delete: if isValidId(consultationId) && isAdmin();
    }

    // 7. Practice Operations Hub (Verified Practice Admin Only)
    match /practiceOps/{hubId} {
      allow get: if isValidId(hubId) && isAdmin();
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(hubId)
        && isAdmin()
        && isValidPracticeOps(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(hubId)
        && isValidPracticeOps(incoming())
        && isAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'preset', 'clients', 'checkins', 'actions',
          'referrals', 'payments', 'meds', 'mmasResponses',
          'bhlsResponses', 'launchDone', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // 8. Client Check-Ins Collection
    match /checkins/{checkinId} {
      allow get: if isValidId(checkinId)
        && isVerifiedUser()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isVerifiedUser()
        && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isValidId(checkinId)
        && isVerifiedUser()
        && isValidClientCheckIn(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().done == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(checkinId)
        && isValidClientCheckIn(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().clientId == existing().clientId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || isOwner(existing().ownerId))
        && incoming().diff(existing()).affectedKeys().hasOnly(['done', 'note', 'date', 'type', 'updatedAt']);

      allow delete: if isValidId(checkinId) && (isAdmin() || isOwner(existing().ownerId));
    }

    // 9. Hashed Portal Access Passes (Exact 64-char SHA-256 Lookup Only, Admin Managed)
    match /accessPasses/{passHash} {
      allow get: if isValidPassHash(passHash);
      allow list: if isBootstrappedAdmin();

      allow create: if isValidPassHash(passHash)
        && isAdmin()
        && isValidAccessPass(incoming(), passHash)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidPassHash(passHash)
        && isAdmin()
        && isValidAccessPass(incoming(), passHash)
        && incoming().passHash == existing().passHash
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'area', 'label', 'agreementSigned', 'active', 'updatedAt'
        ]);

      allow delete: if isValidPassHash(passHash) && isAdmin();
    }
  }
}
